{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "outDir": "./app/static/js",
    "rootDir": "./app/assets/ts",
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["app/assets/ts/**/*"],
  "exclude": ["node_modules"]
}
